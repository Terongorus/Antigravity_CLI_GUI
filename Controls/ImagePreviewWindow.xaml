<Window x:Class="TeronClaudeCodeVS.Controls.ImagePreviewWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Image Preview" SizeToContent="WidthAndHeight"
        WindowStartupLocation="CenterScreen"
        Background="#1E1E1E"
        Loaded="OnLoaded">
    <!--
        The fit-to-window cap lives on the Image itself, not the Window - a Window with
        SizeToContent="WidthAndHeight" measures its content with infinite available space, so a
        MaxWidth/MaxHeight on the WINDOW only capped the window's own size while the Image (Stretch=
        None) still rendered at the source's native resolution inside it, leaving scrollbars for any
        screenshot bigger than the cap instead of the image scaling down to fit (flagged live
        2026-09-06). Stretch=Uniform+StretchDirection=DownOnly on the Image scales large images down
        to fit these bounds while leaving small ones at native size.

        Ctrl+MouseWheel then zooms past that fit-to-window baseline via the LayoutTransform below
        (LayoutTransform, not RenderTransform, so the ScrollViewer's extent actually grows and shows
        scrollbars once zoomed in - a plain RenderTransform wouldn't affect layout/measurement at all).
        OnLoaded freezes the window at its initial fit-to-screen size so zooming grows the image
        inside a fixed viewport instead of the window continuing to resize itself.
    -->
    <ScrollViewer x:Name="PreviewScroll" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto"
                  PreviewMouseWheel="OnPreviewMouseWheel">
        <Image x:Name="PreviewImage" Stretch="Uniform" StretchDirection="DownOnly"
               MaxWidth="1200" MaxHeight="900">
            <Image.LayoutTransform>
                <ScaleTransform x:Name="ImageScale"/>
            </Image.LayoutTransform>
        </Image>
    </ScrollViewer>
</Window>
